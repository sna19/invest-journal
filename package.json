{
	"name": "invest-journal",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"test": "vitest run",
		"start": "node build",
		"db:generate": "drizzle-kit generate --config drizzle.app.config.ts && drizzle-kit generate --config drizzle.market.config.ts",
		"listings": "node scripts/run-job.mjs listings",
		"help:doc": "node scripts/help-doc.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0",
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4",
		"lightweight-charts": "5.3.0",
		"marked": "^18.2.0",
		"node-cron": "^4.6.0"
	}
}
